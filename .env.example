# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=cloudcode-audio
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# MQTT Broker (EMQX)
MQTT_BROKER_URL=wss://broker.emqx.io:8084/mqtt
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password

# Weather API (Open-Meteo is free, no key needed)
# Optional: Tomorrow.io as backup
TOMORROW_IO_API_KEY=your-api-key

# OpenAI (for AI features)
OPENAI_API_KEY=your-openai-key

# App Configuration
PUBLIC_APP_NAME=Cloud Code
PUBLIC_APP_URL=http://localhost:5173
NODE_ENV=development
